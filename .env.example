# ─────────────────────────────────────────────────────────────
# EduFix — Environment Variables
# Copy to `.env.local`. The app runs out-of-the-box with NO edits:
# it uses an automatic in-memory MongoDB and local-disk uploads,
# and auto-seeds demo data on first run.
# ─────────────────────────────────────────────────────────────

# --- Database ---
# Leave MONGODB_URI empty to use an automatic in-memory MongoDB (demo mode).
# For production set a MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/edufix?retryWrites=true&w=majority
MONGODB_URI=

# Auto-seed demo data when the database is empty (recommended for demos).
AUTO_SEED=true

# --- JWT auth (CHANGE IN PRODUCTION) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Cloudinary (optional) ---
# If all three are set, media uploads go to Cloudinary; otherwise local disk (/public/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Uploads ---
MAX_FILE_SIZE_MB=25

# --- Seed admin credentials ---
SEED_ADMIN_EMAIL=admin@edufix.edu
SEED_ADMIN_PASSWORD=Admin@123
